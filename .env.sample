# Copy to .env (or run scripts/generate_env.sh) and fill in. Never commit .env.

NEXUS_ENV=development

# Database credentials used by docker compose / the gateway / the orchestrator
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_operational
MONGO_USER=nexus_admin
MONGO_PASSWORD=

# Shared secret between the Java gateway and the Python orchestrator WebSocket
NEXUS_INTERNAL_TOKEN=

# API keys for the three gateway clients (stored in Postgres as SHA-256 hashes)
NEXUS_ADMIN_API_KEY=
NEXUS_ANALYST_API_KEY=
NEXUS_INGEST_API_KEY=

# Reasoner: ollama (free, default) | anthropic (paid, COMPLEX_REASONING only) | fake (tests)
NEXUS_REASONER_PROVIDER=ollama
# Only needed when NEXUS_REASONER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Hard cap on Claude spend per orchestrator process (USD)
NEXUS_SPEND_CAP_USD=2.00

# Python image for the orchestrator (default command), the dashboard and the batch jobs.
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app MLFLOW_DISABLE_AGENT_HINT=1 MLFLOW_DISABLE_TELEMETRY=true
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY config ./config
COPY ai_orchestrator ./ai_orchestrator
# Ship a trained router with the image; the registry copy (NEXUS_ROUTER_MODEL_URI) overrides it.
RUN python -m ai_orchestrator.training.train_router --output /app/artifacts/intent_router.joblib

RUN useradd --create-home --uid 10001 nexus && mkdir -p /app/data && chown -R nexus /app/data /app/artifacts
USER nexus
EXPOSE 8765
CMD ["python", "-m", "ai_orchestrator.server"]
